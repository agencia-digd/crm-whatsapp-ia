[Unit]
Description=Copiloto — lembrete de véspera (D-1) da visita: avisa a CORRETORA, lê a resposta dela e cobra o silêncio
After=network.target postgresql.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/crm
EnvironmentFile=/opt/crm/.env
ExecStart=/opt/crm/.venv/bin/python scripts/lembrete_visita_d1_tick.py
